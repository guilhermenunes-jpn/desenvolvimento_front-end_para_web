body {
    background-color: rgb(52, 97, 115);
    font-family: Arial, Helvetica, sans-serif
    }
    
    *{
     margin: 0;
     padding: 0;
     box-sizing: border-box;
    }
    html{
        font-size: 75.65%;
    }
    .navbar ul{
      display: flex;
      list-style: none;
      gap: 5px;
    }
    
    header {
        background-color: rgb(20, 51, 64);
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 3);
        padding:5px 5px;
        position: fixed;
        width: 100%;
        min-height:30px;
        z-index:100;
    }
        .logo{
            font-size: 3rem;
            text-decoration: none;
            color: rgb(255, 255, 255);
            text-shadow: 1px 1px 1px rgba(0,0,0,0,2);
            font-weight: 700;
    }
    .navbar a:link,
    .navbar a:visited{
        color: rgb(255, 255, 255);
        font-size: 1.8rem;
        padding: 10px 15px;
        text-decoration: none;
    
    }
    .navbar a:hover,
    .navbar:active{
        background: rgb(52, 97, 115)
    }
    #hero{
        background-image: url(../img/renee_olmsted_photography-sign-2507732_1920\ \(1\).jpg);
        width: 100%;
        height: 100%;
        background-size: cover;
        background-repeat: no-repeat;
    }
    h1{
        text-align:center;
        padding: 40px 0;
        font-size: 3rem;
    }
    section{
       padding: 50px 20px;
       min-height: 100vh;
       display: flex;
       flex-direction: column;
       justify-content: center;
    }
    #about{
        background-color:rgb(52, 97, 115);
    }

    #about p{
        font-size: 2rem;
        line-height: 3rem;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
        padding-bottom: 20px;
    }

    #gallery {
        background-color:rgb(255, 255, 255);
        display: block;
        text-align: center;
        height: 200px;
        width: 300px;
        object-fit: cover;
        display: inline-block;
        margin: 15px;
        border: 2px solid;
        box-shadow: 5px  5px 20px rgba(0, 0, 0, 0.5);
        transition: transform 0.3s ease;
    }

    #gallery img:hover{
        transform: scale(1.03);
    }
